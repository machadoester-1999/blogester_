---
/*
  Logo DASSIE — conceito "Hairline":
  sem serifa ultrafina, letras bem abertas e um fio fino centralizado embaixo.
  O fio é desenhado (scaleX) na primeira pintura da página.
*/
import { SITE_TITLE } from '../consts';

interface Props {
  size?: 'sm' | 'md' | 'lg';
}

const { size = 'md' } = Astro.props;
---

<span class:list={['logo', `logo--${size}`]} aria-label={SITE_TITLE} role="img">
  <span class="word" aria-hidden="true">{SITE_TITLE}</span>
  <span class="rule" aria-hidden="true"></span>
</span>

<style>
  .logo {
    --tracking: 0.52em;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.42em;
    line-height: 1;
    color: currentColor;
  }

  .logo--sm {
    font-size: 0.95rem;
  }

  .logo--md {
    font-size: 1.15rem;
  }

  @media (max-width: 420px) {
    .logo--md {
      font-size: 1rem;
    }
  }

  .logo--lg {
    font-size: 2rem;
  }

  .word {
    font-family: var(--font-body);
    font-weight: 200;
    letter-spacing: var(--tracking);
    /* O tracking também entra depois do último "E"; isto recentraliza a palavra */
    margin-right: calc(var(--tracking) * -1);
    text-transform: uppercase;
  }

  .rule {
    display: block;
    width: 2.6em;
    height: 1px;
    background: currentColor;
    opacity: 0.85;
    transform-origin: center;
    animation: rule-draw 1.1s var(--ease-premium) 0.15s both;
  }

  @keyframes rule-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rule {
      animation: none;
    }
  }
</style>
